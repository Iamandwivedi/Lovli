{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": { "simulator": false },
      "env": {
        "EXPO_PUBLIC_BACKEND_URL": "https://api.lovli.in",
        "EXPO_PUBLIC_DEV_AUTO_LOGIN": "false"
      }
    },
    "simulator": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": { "simulator": true },
      "env": {
        "EXPO_PUBLIC_BACKEND_URL": "https://api.lovli.in",
        "EXPO_PUBLIC_DEV_AUTO_LOGIN": "false"
      }
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_BACKEND_URL": "https://api.lovli.in",
        "EXPO_PUBLIC_DEV_AUTO_LOGIN": "false"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_BACKEND_URL": "https://api.lovli.in",
        "EXPO_PUBLIC_DEV_AUTO_LOGIN": "false"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
