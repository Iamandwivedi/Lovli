# Lovli mobile (Expo) environment.
#
# Only EXPO_PUBLIC_* vars reach the JS bundle, and anything that reaches the
# bundle is readable by anyone with the app. NEVER put secrets here: no
# Anthropic key, no Mongo URL, no JWT secret — those are backend-only.
#
# LOAD ORDER (Expo, highest priority first):
#   1. .env.{mode}.local
#   2. .env.local        <- your machine, git-ignored: put local overrides here
#   3. .env.{mode}
#   4. .env              <- committed default: production API
#
# So the normal setup is:
#   .env        -> https://api.lovli.in   (device + EAS builds just work)
#   .env.local  -> http://<your-LAN-IP>:8001  (local backend development)
#
# EAS builds do NOT receive these files (they are git-ignored and never
# uploaded). Build-time values live in eas.json under each profile's "env".

# Production API. No trailing slash — the client appends /api itself.
EXPO_PUBLIC_BACKEND_URL=https://api.lovli.in

# Auto sign-in as the seeded tester account on launch. Only works when the
# backend has ALLOW_TEST_LOGIN=true, which is never the case in production.
EXPO_PUBLIC_DEV_AUTO_LOGIN=false

# Verbose client logging.
EXPO_PUBLIC_DEBUG=false
