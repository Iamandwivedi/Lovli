# Lovli mobile (Expo) environment — copy to `.env`.
# Only EXPO_PUBLIC_* vars reach the JS bundle. NEVER put secrets here:
# no Anthropic key, no Mongo URL, no JWT secret — those are backend-only.

# Production:
# EXPO_PUBLIC_BACKEND_URL=https://api.lovli.in
#
# Local dev against your machine — use your LAN IP (not localhost) so a real
# phone on the same Wi-Fi can reach it:
EXPO_PUBLIC_BACKEND_URL=http://192.168.1.10:8001

# Optional: verbose client logging
EXPO_PUBLIC_DEBUG=false
