# Lovli backend environment — copy to `.env` and fill in.
# Real values live ONLY in Railway (production) and your local .env (git-ignored).
# Canonical reference: docs/ENVIRONMENT_VARIABLES.md

# ---- Database (required) ----------------------------------------------------
# Local dev:  mongodb://localhost:27017
# Production: mongodb+srv://lovli_app:<PASSWORD>@cluster0.xxxxx.mongodb.net/lovli?retryWrites=true&w=majority
MONGO_URL=mongodb://localhost:27017
DB_NAME=lovli

# Connection pool sizing (optional). Defaults suit a single Railway instance.
# MONGO_MAX_POOL_SIZE=100
# MONGO_MIN_POOL_SIZE=0

# ---- Auth (required) --------------------------------------------------------
# Generate each with: openssl rand -hex 32
JWT_SECRET=change-me-openssl-rand-hex-32
ADMIN_KEY=change-me-openssl-rand-hex-32

# ---- LLM (required) ---------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-api03-xxxxx
LLM_PROVIDER=auto
# CLAUDE_MODEL=claude-sonnet-4-5-20250929
# EMERGENT_LLM_KEY=

# ---- Google OAuth (required in production) ----------------------------------
GOOGLE_CLIENT_ID=xxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxxx
GOOGLE_ALLOWED_REDIRECT_URIS=https://app.lovli.in/auth,https://lovli.in/auth

# ---- App --------------------------------------------------------------------
CORS_ORIGINS=http://localhost:3000,http://localhost:8081
ENVIRONMENT=development
# NEVER true in production — gated again by ENVIRONMENT != production.
ALLOW_TEST_LOGIN=true
PYTHONUNBUFFERED=1

# ---- Memory engine ----------------------------------------------------------
# Event capture always runs. This flag gates the READ side (personalized
# prompts, reply reranking, memory_used). Flip to true after backfill.
MEMORY_ENGINE_ENABLED=false

# ---- Data retention (optional) ----------------------------------------------
# Days before raw behavioral events expire (derived memory survives). 0 = keep.
# EVENT_RETENTION_DAYS=400
